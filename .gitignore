# ============================================================
# NEVER COMMIT: credentials and keys
# ============================================================
account.txt
*.pem
*.key
.env
.env.*
!.env.example

# ============================================================
# User data — assessment records contain health questionnaire
# features and must not enter version control
#
# Anchored to the runtime log directory only. A bare `data/`
# would also swallow service/app/data/, which holds reference
# tables the app needs at run time — they must be committed.
# ============================================================
/service/data/
/data/
*.jsonl

# ============================================================
# Python
# ============================================================
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Local archives / working copies
# The research materials live unpacked under model/ — the
# original bundle itself is redundant.
# ============================================================
Dengue_项目分享.zip
Domain-Adaptation-LLM-vs-Agentic.pdf

# Raw SINAN surveillance data is downloaded from DATASUS at
# training time (~9.45M rows) and is never vendored here.
model/data/
*.parquet
*.csv

# ============================================================
# Editors / OS
# ============================================================
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Office lock files (opening tracked .docx/.pptx on Windows drops these)
~$*

# Local deliverables staging (never tracked)
/交付物/
