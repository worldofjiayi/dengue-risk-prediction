# ============ DeepSeek 配置 ============
# DeepSeek API 密钥（留空则无法调用真实接口，请配合 MOCK_MODE=true 使用）
DEEPSEEK_API_KEY=
# DeepSeek 接口基础地址（OpenAI 兼容格式）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称（实际使用 deepseek v4 时改成对应模型名）
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek 请求超时时间（秒），可选，默认 60
# DEEPSEEK_TIMEOUT=60

# ============ ML 模型配置 ============
# ML 模型文件路径（留空或文件不存在时，自动使用内置启发式假模型）
ML_MODEL_PATH=

# ============ 评测数据回流 ============
# 每次评估完成后把脱敏记录（特征+评分+语言+时间戳，不含 notes 原文）
# 追加到该 JSONL 文件；相对路径相对项目根目录解析，置空则关闭
# EVAL_LOG_PATH=data/assessments.jsonl

# ============ 联网检索（按次计费，务必先读 README 的 Web search 一节）============
# 检索走 DeepSeek 的 **Anthropic 兼容端点**（<DEEPSEEK_BASE_URL>/anthropic/v1/messages）
# 的服务端工具 web_search_20250305；OpenAI 兼容端点不支持它。
#
# 总开关：false 时 /api/chat 与 /api/destination 都不会发起任何检索，
# /api/destination 仍然返回地区表 + WHO 通报这一层，search_status=disabled
# SEARCH_ENABLED=true
#
# 单次请求允许的检索次数上限（传给 web_search 工具的 max_uses）。
# 实测：一个普通问题在不设上限时触发了 4 次检索、约 13.9k 输入 token
# SEARCH_MAX_USES=2
#
# 目的地查询缓存有效期（秒），按 (规范地名, 语言) 缓存，默认 6 小时。
# 同一个国家在有效期内的第二次查询完全不发请求
# SEARCH_CACHE_TTL_SECONDS=21600

# ============ 运行模式 ============
# 演示模式：true 时 DeepSeek 与 ML 模型均返回可信假数据，不发真实请求
# （检索也一样：MOCK_MODE=true 时永远不出网，返回固定的演示来源）
MOCK_MODE=true

# ============ 服务监听 ============
HOST=0.0.0.0
PORT=8000
