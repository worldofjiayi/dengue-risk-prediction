# ============ DeepSeek ============
# DeepSeek API key (leave empty and keep MOCK_MODE=true if you have no key)
DEEPSEEK_API_KEY=
# Base URL of the DeepSeek API (OpenAI-compatible protocol)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model name (switch to the matching name when using a newer DeepSeek release)
DEEPSEEK_MODEL=deepseek-chat
# Request timeout in seconds, optional, defaults to 60
# DEEPSEEK_TIMEOUT=60

# ============ Evaluation feedback loop ============
# After each completed assessment, append a de-identified record (features +
# scores + language + timestamp, never the free-text notes) to this JSONL file.
# Relative paths resolve against the service/ directory; leave empty to disable.
# EVAL_LOG_PATH=data/assessments.jsonl

# ============ Web search (metered per search; read the README's Web search section first) ============
# Search uses the server-side web_search_20250305 tool of DeepSeek's **Anthropic-
# compatible endpoint** (<DEEPSEEK_BASE_URL>/anthropic/v1/messages); the
# OpenAI-compatible endpoint does not support it.
#
# Master switch: when false, neither /api/chat nor /api/destination issues any
# search; /api/destination still returns the endemicity table + WHO notices,
# with search_status=disabled
# SEARCH_ENABLED=true
#
# Per-request cap on search count (passed to the web_search tool as max_uses).
# Measured: one ordinary question with no cap triggered 4 searches, ~13.9k input tokens
# SEARCH_MAX_USES=2
#
# Destination-lookup cache lifetime in seconds, keyed by (canonical place,
# language), default 6 hours. A second query for the same country within the
# window issues no request at all
# SEARCH_CACHE_TTL_SECONDS=21600

# ============ Run mode ============
# Demo mode: when true, LLM advice/chat/search return canned local templates and
# nothing goes out on the network; risk scores are always computed by the real
# model coefficients.
MOCK_MODE=true

# ============ Server bind ============
# In production the port is fixed at 80 on the systemd unit's ExecStart line;
# HOST/PORT here only affect deploy/run.sh and `python app/main.py`.
HOST=0.0.0.0
PORT=8000
