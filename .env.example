# ============ DeepSeek 配置 ============
# DeepSeek API 密钥（留空则无法调用真实接口，请配合 MOCK_MODE=true 使用）
DEEPSEEK_API_KEY=
# DeepSeek 接口基础地址（OpenAI 兼容格式）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称（实际使用 deepseek v4 时改成对应模型名）
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek 请求超时时间（秒），可选，默认 60
# DEEPSEEK_TIMEOUT=60

# ============ ML 模型配置 ============
# ML 模型文件路径（留空或文件不存在时，自动使用内置启发式假模型）
ML_MODEL_PATH=

# ============ 评测数据回流 ============
# 每次评估完成后把脱敏记录（特征+评分+语言+时间戳，不含 notes 原文）
# 追加到该 JSONL 文件；相对路径相对项目根目录解析，置空则关闭
# EVAL_LOG_PATH=data/assessments.jsonl

# ============ 运行模式 ============
# 演示模式：true 时 DeepSeek 与 ML 模型均返回可信假数据，不发真实请求
MOCK_MODE=true

# ============ 服务监听 ============
HOST=0.0.0.0
PORT=8000
